# Copy to .env and set OPENAI_API_KEY for voice + LLM.
# DATABASE_URL — ваш локальный PostgreSQL (рекомендуется); пример ниже замените user/pass/db.

APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/neurofriend
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
OPENAI_API_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

CHAT_MAX_MESSAGES_PER_THREAD=500
CHAT_CARRYOVER_MESSAGES=10
