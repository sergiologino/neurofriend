# Copy to backend/.env (see docs/LOCAL_SETUP_WINDOWS.md). OPENAI_API_KEY — для LLM, Whisper, эмбеддингов, TTS.

APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/neurofriend
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
OPENAI_API_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

CHAT_MAX_MESSAGES_PER_THREAD=500
CHAT_CARRYOVER_MESSAGES=10

# Stage C (романтическая динамика + TTS)
# ROMANTIC_DYNAMICS_ENABLED=true
# ROMANTIC_SIGNAL_CLASSIFIER_LLM_ENABLED=true
# STAGE_C_TTS_PROSODY_ENABLED=true
# ROMANTIC_STYLE_PROFILES_ENABLED=true

# v4.4 repair initiative + tracked events (см. docs/ai/CURRENT_STATE.md)
# TRACKED_EVENTS_ENABLED=true
# EVENT_CLARIFICATION_ENABLED=true
# TRACKED_EVENT_REMINDERS_ENABLED=true
# REPAIR_INITIATIVE_ENABLED=true
# REPAIR_READINESS_THRESHOLD=0.62
# REPAIR_INITIATIVE_GAP_HOURS_MIN=3
# REPAIR_ATTEMPT_GAP_HOURS=18
# REPAIR_ATTEMPT_MAX=4

# LLM / речь (опционально; см. app/core/config.py)
# CHAT_MODEL=gpt-4o-mini
# WHISPER_MODEL=whisper-1
# TTS_MODEL=tts-1
# TTS_VOICE=alloy

# Семантическая память
# SEMANTIC_MEMORY_ENABLED=true
# QDRANT_COLLECTION_SEMANTIC=neurofriend_semantic
# EMBEDDING_MODEL=text-embedding-3-small
# SEMANTIC_MEMORY_TOP_K=8

# Инициатива (cron / ручной sweep)
# INITIATIVE_ENABLED=true
# INITIATIVE_GAP_HOURS_MIN=4
# INITIATIVE_GAP_HOURS_STRONG=24
# INITIATIVE_READINESS_THRESHOLD=0.55
# INITIATIVE_QUIET_HOURS_START_UTC=22
# INITIATIVE_QUIET_HOURS_END_UTC=7
# INITIATIVE_COOLDOWN_HOURS=12
# INITIATIVE_SWEEP_SECRET=
